*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*.swp
*.swo
*~

# Linux
*~
.directory
.Trash-*
.nfs*

