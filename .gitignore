*.jpg
*.jpeg
*.png
*.gif
*.svg
*.webp
*.ico
*.bmp
*.tiff

# Dossier images (exclu)
images/

# ==================== Documents ====================

# Exclusion des documents temporaires
*.tmp
*.temp

# Attention : Le PowerPoint doit être conservé dans le dépôt
# Ne pas exclure docs/*.pptx
# !docs/*.pptx

# ==================== Fichiers spécifiques au projet ====================

.DS_Store
*.log
*.tmp
*.cache

# Fichiers de configuration locaux
*.local
*.user

